{
  "name": "vibe-rico",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.19.0 <25",
    "pnpm": "11.25.0"
  },
  "scripts": {
    "lint": "node scripts/check-boundaries.mjs && node --test 'scripts/*.test.mjs'",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "test:db": "pnpm --filter @vibe-rico/server test:db",
    "test:e2e": "pnpm --filter @vibe-rico/web test:e2e"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vitest": "5.0.2"
  }
}
