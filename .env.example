# Copy to .env and change before the first start. .env is never committed or copied into the image.
POSTGRES_PASSWORD=change-me-to-a-long-random-value
# Host port for the game service (bound to 127.0.0.1; expose it through a TLS reverse proxy).
APP_PORT=3000

# Comma-separated frontend origins allowed to connect to Socket.IO.
CORS_ORIGINS=https://webri.co
