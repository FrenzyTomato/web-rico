{
  "name": "@vibe-rico/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p ../../packages/game-engine && tsc -p ../../packages/protocol && tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "tsc -p ../../packages/game-engine && tsc -p ../../packages/protocol && tsc -p tsconfig.test.json && vitest run",
    "build": "tsc -p ../../packages/game-engine && tsc -p ../../packages/protocol && tsc",
    "start": "node dist/main.js",
    "test:db": "tsc -p ../../packages/game-engine && tsc -p ../../packages/protocol && tsc && node scripts/with-postgres.mjs",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@fastify/static": "10.1.5",
    "@vibe-rico/game-engine": "workspace:*",
    "@vibe-rico/protocol": "workspace:*",
    "drizzle-orm": "0.45.3",
    "fastify": "5.12.5",
    "postgres": "3.4.9",
    "socket.io": "4.8.4"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "drizzle-kit": "0.31.11",
    "socket.io-client": "4.8.4"
  }
}
