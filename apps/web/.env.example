# Public HTTPS Socket.IO backend for split hosting (Vercel + DigitalOcean).
# Leave unset for same-origin Docker hosting or the local Vite proxy.
# Set this in Vercel project environment variables before building.
VITE_SERVER_URL=

# Frontend-only room creation gate; visible in the browser bundle, not a secret.
# Disabled by default. Set ENABLED=true to require the password.
# When enabled, a missing password blocks creation. Rebuild after changes.
VITE_ROOM_CREATION_PASSWORD_ENABLED=false
VITE_ROOM_CREATION_PASSWORD=
