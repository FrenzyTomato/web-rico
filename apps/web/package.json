{
  "name": "@vibe-rico/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -p ../../packages/game-engine && tsc -p ../../packages/protocol && tsc --noEmit",
    "test": "tsc -p ../../packages/game-engine && tsc -p ../../packages/protocol && tsc --noEmit && vitest run",
    "build": "tsc -p ../../packages/game-engine && tsc -p ../../packages/protocol && tsc --noEmit && vite build",
    "test:e2e": "tsc -p ../../packages/game-engine && tsc -p ../../packages/protocol && pnpm --filter @vibe-rico/server build && playwright test"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "5.3.0",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.1",
    "@vibe-rico/protocol": "workspace:*",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "socket.io-client": "4.8.4",
    "three": "0.186.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vibe-rico/game-engine": "workspace:*",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.1.1",
    "vite": "8.3.1"
  }
}
